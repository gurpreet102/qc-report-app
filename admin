<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QC Admin Dashboard</title>

    <!-- Firebase Compatibility SDKs -->
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>

    <!-- Chart.js library for interactive charts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
      // Replace with your actual Firebase configuration keys
      const firebaseConfig = {
        apiKey: "AIzaSyD1fZFNWY5hbsShHwhq1dWUYpYkizWwekc",
        authDomain: "qc-report-app.firebaseapp.com",
        projectId: "qc-report-app",
        storageBucket: "qc-report-app.firebasestorage.app",
        messagingSenderId: "983700095052",
        appId: "1:983700095052:web:684d291d05d8d44573b4e9"
      };

      firebase.initializeApp(firebaseConfig);
      const db = firebase.firestore();
      
      // Force long polling to bypass network firewall / WebSocket restrictions
      db.settings({
        experimentalForceLongPolling: true
      });

      // Enable persistence for instant loads
      db.enablePersistence({ synchronizeTabs: true }).catch(function() {});
    </script>

    <style>
        :root {
            --bg: #f8fafc;
            --surface: #ffffff;
            --primary: #0f172a;
            --accent: #0284c7;
            --border: #e2e8f0;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --danger-bg: #fee2e2;
            --danger-text: #991b1b;
            --success-bg: #dcfce7;
            --success-text: #166534;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background-color: var(--bg); color: var(--text-main); padding: 20px; }
        .container { max-width: 1100px; margin: 0 auto; }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border);
        }
        h1 { font-size: 1.5rem; color: var(--primary); }

        /* Stats Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
            margin-bottom: 20px;
        }
        .stat-card {
            background: var(--surface);
            padding: 16px;
            border-radius: 8px;
            border: 1px solid var(--border);
        }
        .stat-card .label { font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; }
        .stat-card .value { font-size: 1.8rem; font-weight: 800; color: var(--primary); margin-top: 4px; }

        /* Data Visualizations Grid */
        .charts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }
        .chart-card {
            background: var(--surface);
            padding: 18px;
            border-radius: 8px;
            border: 1px solid var(--border);
        }
        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }
        .chart-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
        }
        .chart-hint {
            font-size: 0.75rem;
            color: var(--accent);
            font-weight: 600;
        }
        .chart-container {
            position: relative;
            height: 240px;
            width: 100%;
        }

        /* Category Aggregation Bar */
        .category-summary-bar {
            background: var(--surface);
            padding: 14px 16px;
            border-radius: 8px;
            border: 1px solid var(--border);
            margin-bottom: 24px;
        }
        .category-summary-title {
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            margin-bottom: 10px;
        }
        .category-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        .category-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            background: #f1f5f9;
            border: 1px solid var(--border);
            border-radius: 16px;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-main);
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .category-pill:hover {
            background: #e2e8f0;
            border-color: var(--accent);
        }
        .category-pill-count {
            background: var(--danger-bg);
            color: var(--danger-text);
            padding: 2px 6px;
            border-radius: 10px;
            font-size: 0.75rem;
            font-weight: 800;
        }

        /* Filter Controls */
        .controls {
            background: var(--surface);
            padding: 16px;
            border-radius: 8px;
            border: 1px solid var(--border);
            margin-bottom: 24px;
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            align-items: center;
        }
        .controls input[type="text"], .controls select {
            padding: 10px 12px;
            border: 1px solid var(--border);
            border-radius: 6px;
            outline: none;
            font-size: 0.9rem;
            flex: 1;
            min-width: 160px;
        }
        .controls input[type="date"] {
            padding: 8px 10px;
            border: 1px solid var(--border);
            border-radius: 6px;
            outline: none;
            font-size: 0.85rem;
        }
        .btn {
            border: none;
            padding: 10px 16px;
            border-radius: 6px;
            font-weight: 700;
            cursor: pointer;
            font-size: 0.85rem;
        }
        .btn-refresh { background: var(--accent); color: white; }
        .btn-export { background: #16a34a; color: white; }
        .btn-consolidated { background: #7c3aed; color: white; }
        .btn-whatsapp {
            background-color: #25D366;
            color: white;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-whatsapp:hover {
            background-color: #1ebc57;
        }

        /* Table */
        .table-container {
            background: var(--surface);
            border-radius: 8px;
            border: 1px solid var(--border);
            overflow-x: auto;
        }
        table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem; }
        th, td { padding: 12px 16px; border-bottom: 1px solid var(--border); }
        th { background: #f1f5f9; color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; }
        tr:hover { background: #f8fafc; }

        .badge {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 700;
        }
        .badge-danger { background: var(--danger-bg); color: var(--danger-text); }

        .btn-view {
            background: #f1f5f9;
            border: 1px solid var(--border);
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.8rem;
        }

        /* Pagination Bar */
        .pagination-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 16px;
            padding: 12px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
        }

        /* Modal */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.6);
            align-items: center;
            justify-content: center;
            padding: 16px;
            z-index: 1000;
        }
        .modal {
            background: var(--surface);
            border-radius: 8px;
            max-width: 650px;
            width: 100%;
            max-height: 85vh;
            display: flex;
            flex-direction: column;
        }
        .modal-header {
            padding: 16px;
            border-bottom: 1px solid var(--border);
            font-weight: 700;
            display: flex;
            justify-content: space-between;
        }
        .modal-body {
            padding: 16px;
            overflow-y: auto;
            background: #f8fafc;
        }
        .modal-footer {
            padding: 12px 16px;
            border-top: 1px solid var(--border);
            text-align: right;
            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }

        /* Consolidated Report Style */
        pre.consolidated-report {
            background: #1e293b;
            color: #f8fafc;
            padding: 20px;
            border-radius: 8px;
            font-size: 0.85rem;
            white-space: pre-wrap;
            word-wrap: break-word;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            max-height: 55vh;
            overflow-y: auto;
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>QC Reports Dashboard</h1>
        <div style="display: flex; gap: 8px;">
            <button class="btn btn-consolidated" onclick="openConsolidatedModal()">📊 Consolidated Report</button>
            <button class="btn btn-export" onclick="exportToCSV()">📥 Export CSV</button>
            <button class="btn btn-refresh" onclick="fetchReports()">🔄 Refresh</button>
        </div>
    </header>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="label">Total Submitted Audits</div>
            <div class="value" id="stat-total">0</div>
        </div>
        <div class="stat-card">
            <div class="label">Total Exceptions Recorded</div>
            <div class="value" id="stat-exceptions-count" style="color: var(--danger-text);">0</div>
        </div>
    </div>

    <!-- Data Visualizations -->
    <div class="charts-grid">
        <div class="chart-card">
            <div class="chart-header">
                <div class="chart-title">Issue Distribution by Category</div>
                <div class="chart-hint">💡 Click segment to filter table</div>
            </div>
            <div class="chart-container">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
        <div class="chart-card">
            <div class="chart-header">
                <div class="chart-title">Day-Wise Exception Trend</div>
                <div class="chart-hint" id="dayWiseBadge">💡 Last 10 Days</div>
            </div>
            <div class="chart-container">
                <canvas id="dayWiseChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Overall Exception Categories Breakdown -->
    <div class="category-summary-bar">
        <div class="category-summary-title">Flagged Issue Count per Category (Click to Filter)</div>
        <div class="category-pills" id="category-summary-pills">
            <span style="color: var(--text-muted); font-size: 0.85rem;">Calculating totals...</span>
        </div>
    </div>

    <div class="controls">
        <input type="text" id="filter-search" placeholder="Search Sewadar, Canteen, or DIC..." oninput="applyFilters()">
        
        <select id="filter-status" onchange="applyFilters()">
            <option value="ALL">All Audits</option>
            <option value="ISSUES">Has Exceptions Only</option>
        </select>

        <select id="filter-category" onchange="applyFilters()">
            <option value="ALL">All Categories</option>
        </select>

        <div style="display: flex; gap: 8px; align-items: center; flex: 1; min-width: 280px;">
            <input type="date" id="filter-start-date" onchange="applyFilters()" title="Start Date">
            <span style="color: var(--text-muted); font-size: 0.85rem;">to</span>
            <input type="date" id="filter-end-date" onchange="applyFilters()" title="End Date">
            <button type="button" onclick="clearAllFilters()" style="padding: 8px 12px; background: #e2e8f0; border: none; border-radius: 6px; cursor: pointer; font-size: 0.8rem; font-weight: 600;">Reset Filters</button>
        </div>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Date & Time</th>
                    <th>Canteen #</th>
                    <th>Sewadar</th>
                    <th>Exceptions</th>
                    <th>Flagged Categories</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="table-body">
                <tr><td colspan="6" style="text-align:center; color: var(--text-muted);">Loading reports...</td></tr>
            </tbody>
        </table>
    </div>

    <div class="pagination-bar">
        <div style="font-size: 0.85rem; color: var(--text-muted);" id="pagination-info">
            Showing 0 - 0 of 0 entries
        </div>
        <div style="display: flex; gap: 8px; align-items: center;">
            <label style="font-size: 0.85rem; color: var(--text-muted);">Rows per page:</label>
            <select id="page-size" onchange="changePageSize()" style="padding: 6px; border: 1px solid var(--border); border-radius: 4px; font-size: 0.85rem;">
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
            
            <button id="btn-prev" onclick="prevPage()" style="padding: 6px 12px; border: 1px solid var(--border); background: #f1f5f9; border-radius: 4px; cursor: pointer; font-weight: 600;" disabled>Previous</button>
            <span id="page-num" style="font-size: 0.85rem; font-weight: 700; color: var(--primary);">Page 1</span>
            <button id="btn-next" onclick="nextPage()" style="padding: 6px 12px; border: 1px solid var(--border); background: #f1f5f9; border-radius: 4px; cursor: pointer; font-weight: 600;" disabled>Next</button>
        </div>
    </div>
</div>

<!-- Detailed Categorized Modal -->
<div class="modal-overlay" id="detail-modal">
    <div class="modal">
        <div class="modal-header">
            <span>Header & Remark Analysis</span>
            <button style="border:none; background:none; cursor:pointer;" onclick="closeModal()">✕</button>
        </div>
        <div class="modal-body" id="modal-content"></div>
        <div class="modal-footer">
            <button class="btn" style="background: #e2e8f0;" onclick="closeModal()">Close</button>
        </div>
    </div>
</div>

<!-- Consolidated QC Visit Report Modal -->
<div class="modal-overlay" id="consolidated-modal">
    <div class="modal" style="max-width: 800px;">
        <div class="modal-header">
            <span>📊 Consolidated QC Visit Report</span>
            <button style="border:none; background:none; cursor:pointer;" onclick="closeConsolidatedModal()">✕</button>
        </div>
        <div class="modal-body">
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 12px; flex-wrap: wrap;">
                <div style="display: flex; gap: 8px; align-items: center;">
                    <label style="font-size: 0.85rem; font-weight: 700; color: var(--primary);">Select Date:</label>
                    <input type="date" id="report-target-date" style="padding: 8px 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 0.85rem;" onchange="fetchAndGenerateConsolidatedReport()">
                </div>
                <div style="display: flex; gap: 8px;">
                    <button class="btn btn-refresh" onclick="fetchAndGenerateConsolidatedReport()">🔄 Generate Report</button>
                    <button class="btn btn-view" onclick="copyConsolidatedReport()">📋 Copy Report</button>
                </div>
            </div>
            <pre id="report-output" class="consolidated-report">Select a target date and click 'Generate Report' above to display consolidated observations...</pre>
        </div>
        <div class="modal-footer">
            <a id="whatsapp-share-btn" class="btn btn-whatsapp" href="#" target="_blank" style="display: none;">
                📲 Share via WhatsApp
            </a>
            <button class="btn" style="background: #e2e8f0;" onclick="closeConsolidatedModal()">Close</button>
        </div>
    </div>
</div>

<script>
let allReports = [];
let currentFilteredData = [];
let currentPage = 1;
let pageSize = 10;

let categoryChartInstance = null;
let dayWiseChartInstance = null;

// Category Normalization Map to unify Hindi / Bilingual string variants to standard English
const categoryMap = {
    "counters": "Counters",
    "काउंटर": "Counters",
    "washing area": "Washing Area",
    "बर्तन धुलाई की जगह": "Washing Area",
    "eating area": "Eating Area",
    "खाने की जगह": "Eating Area",
    "pre cooking": "Pre Cooking",
    "precooking": "Pre Cooking",
    "खाना बनाने की तैयारी": "Pre Cooking",
    "floor & canteen area": "Floor & Canteen Area",
    "floor and canteen area": "Floor & Canteen Area",
    "फर्श और कैंटीन": "Floor & Canteen Area",
    "general instructions": "General Instructions",
    "जरूरी बातें": "General Instructions",
    "safety": "Safety",
    "सुरक्षा": "Safety",
    "taste feedback": "Taste Feedback",
    "खाने का स्वाद": "Taste Feedback"
};

// Strict Slot Hierarchy
const SLOT_HIERARCHY = ["Pre-Satsang", "Post-Satsang", "Evening Slot"];

function normalizeCategory(catStr) {
    if (!catStr) return "Uncategorized";
    
    const trimmed = catStr.trim().toLowerCase();

    if (categoryMap[trimmed]) {
        return categoryMap[trimmed];
    }

    if (trimmed.includes("counter") || trimmed.includes("काउंटर")) return "Counters";
    if (trimmed.includes("washing") || trimmed.includes("धुलाई")) return "Washing Area";
    if (trimmed.includes("eating") || (trimmed.includes("खाने") && trimmed.includes("जगह"))) return "Eating Area";
    if (trimmed.includes("pre cooking") || trimmed.includes("तैयारी")) return "Pre Cooking";
    if (trimmed.includes("floor") || trimmed.includes("फर्श") || trimmed.includes("कैंटीन")) return "Floor & Canteen Area";
    if (trimmed.includes("instructions") || trimmed.includes("जरूरी")) return "General Instructions";
    if (trimmed.includes("safety") || trimmed.includes("सुरक्षा")) return "Safety";
    if (trimmed.includes("taste") || trimmed.includes("स्वाद")) return "Taste Feedback";

    return catStr.trim();
}

function getFormattedDateWithDay(dateStr) {
    const parts = dateStr.split('-');
    const year = parseInt(parts[0], 10);
    const month = parseInt(parts[1], 10);
    const day = parseInt(parts[2], 10);
    const dateObj = new Date(year, month - 1, day);
    const options = { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' };
    return dateObj.toLocaleDateString('en-GB', options);
}

document.addEventListener('DOMContentLoaded', function() {
    // Set default date picker in consolidated report modal to today's local date
    const todayStr = new Date().toISOString().split('T')[0];
    document.getElementById('report-target-date').value = todayStr;
    fetchReports();
});

function fetchReports() {
    const tableBody = document.getElementById('table-body');
    tableBody.innerHTML = '<tr><td colspan="6" style="text-align:center; color: var(--text-muted);">Fetching live data...</td></tr>';

    db.collection("reports")
      .get()
      .then(function(querySnapshot) {
          allReports = [];
          querySnapshot.forEach(function(doc) {
              allReports.push(Object.assign({ id: doc.id }, doc.data()));
          });

          // Client-side sorting fallback to ensure stability
          allReports.sort(function(a, b) {
              const timeA = (a.createdAt && a.createdAt.seconds) ? a.createdAt.seconds : 0;
              const timeB = (b.createdAt && b.createdAt.seconds) ? b.createdAt.seconds : 0;
              return timeB - timeA;
          });

          populateCategoryFilterDropdown();
          applyFilters();
      })
      .catch(function(error) {
          console.error("Error loading reports:", error);
          tableBody.innerHTML = '<tr><td colspan="6" style="text-align:center; color: var(--danger-text);">Failed to load data from database: ' + error.message + '</td></tr>';
      });
}

function populateCategoryFilterDropdown() {
    const categorySelect = document.getElementById('filter-category');
    const categoriesSet = new Set();

    allReports.forEach(function(r) {
        if (r.categorizedIssues) {
            r.categorizedIssues.forEach(function(c) {
                categoriesSet.add(normalizeCategory(c.category));
            });
        }
    });

    categorySelect.innerHTML = '<option value="ALL">All Categories</option>';
    categoriesSet.forEach(function(cat) {
        categorySelect.innerHTML += '<option value="' + cat + '">' + cat + '</option>';
    });
}

function updateStatsAndVisuals(filteredData) {
    const total = filteredData.length;
    const totalExceptions = filteredData.reduce(function(acc, r) {
        return acc + (r.exceptionsCount || 0);
    }, 0);

    document.getElementById('stat-total').innerText = total;
    document.getElementById('stat-exceptions-count').innerText = totalExceptions;

    const categoryCounts = {};

    filteredData.forEach(function(r) {
        if (r.categorizedIssues) {
            r.categorizedIssues.forEach(function(c) {
                if (c.issueCount > 0) {
                    const normCat = normalizeCategory(c.category);
                    categoryCounts[normCat] = (categoryCounts[normCat] || 0) + c.issueCount;
                }
            });
        }
    });

    const pillsContainer = document.getElementById('category-summary-pills');
    const categoryEntries = Object.entries(categoryCounts);
    
    if (categoryEntries.length === 0) {
        pillsContainer.innerHTML = '<span style="color: var(--success-text); font-size: 0.85rem; font-weight:600;">✔ No exceptions recorded in selected records.</span>';
    } else {
        pillsContainer.innerHTML = categoryEntries.map(function(entry) {
            const cat = entry[0];
            const count = entry[1];
            return '<div class="category-pill" onclick="filterByCategoryDirect(\'' + cat + '\')" title="Filter table by ' + cat + '">' +
                '<span>' + cat + '</span>' +
                '<span class="category-pill-count">' + count + '</span>' +
            '</div>';
        }).join('');
    }

    renderInteractiveCategoryChart(categoryCounts);
    renderInteractiveDayWiseChart(filteredData);
}

function renderInteractiveCategoryChart(dataObject) {
    const ctx = document.getElementById('categoryChart').getContext('2d');
    const labels = Object.keys(dataObject);
    const data = Object.values(dataObject);

    if (categoryChartInstance) {
        categoryChartInstance.destroy();
    }

    categoryChartInstance = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: labels,
            datasets: [{
                data: data,
                backgroundColor: ['#0284c7', '#0369a1', '#075985', '#0c4a6e', '#38bdf8', '#818cf8', '#c084fc'],
                borderWidth: 2,
                borderColor: '#ffffff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return ' ' + context.label + ': ' + context.raw + ' Issues';
                        }
                    }
                }
            },
            onHover: function(event, chartElement) {
                event.native.target.style.cursor = chartElement[0] ? 'pointer' : 'default';
            },
            onClick: function(e, elements) {
                if (elements.length > 0) {
                    const index = elements[0].index;
                    const selectedCategory = labels[index];
                    filterByCategoryDirect(selectedCategory);
                }
            }
        }
    });
}

function renderInteractiveDayWiseChart(filteredData) {
    const ctx = document.getElementById('dayWiseChart').getContext('2d');
    
    const dailyExceptions = {};

    filteredData.forEach(function(r) {
        let dateStr = null;
        if (r.createdAt && r.createdAt.seconds) {
            const dateObj = new Date(r.createdAt.seconds * 1000);
            dateStr = dateObj.toISOString().split('T')[0];
        } else if (r.date) {
            dateStr = r.date;
        }

        if (dateStr) {
            const excCount = r.exceptionsCount || 0;
            dailyExceptions[dateStr] = (dailyExceptions[dateStr] || 0) + excCount;
        }
    });

    let sortedDates = Object.keys(dailyExceptions).sort(function(a, b) {
        return new Date(a) - new Date(b);
    });

    const isCapped = sortedDates.length > 10;
    if (isCapped) {
        sortedDates = sortedDates.slice(-10);
    }

    const badgeEl = document.getElementById('dayWiseBadge');
    if (badgeEl) {
        badgeEl.textContent = isCapped ? "💡 Showing Last 10 Days" : "💡 Showing Selected Days";
    }

    const labels = sortedDates;
    const data = sortedDates.map(function(date) { return dailyExceptions[date]; });

    if (dayWiseChartInstance) {
        dayWiseChartInstance.destroy();
    }

    dayWiseChartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Exceptions Recorded',
                data: data,
                backgroundColor: '#0284c7',
                hoverBackgroundColor: '#0369a1',
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return ' ' + context.raw + ' total exceptions';
                        }
                    }
                }
            },
            scales: {
                x: { 
                    grid: { display: false },
                    ticks: { font: { size: 11 } }
                },
                y: { 
                    beginAtZero: true, 
                    grid: { color: '#f1f5f9' }, 
                    ticks: { precision: 0 } 
                }
            },
            onHover: function(event, chartElement) {
                event.native.target.style.cursor = chartElement[0] ? 'pointer' : 'default';
            },
            onClick: function(e, elements) {
                if (elements.length > 0) {
                    const index = elements[0].index;
                    const clickedDate = labels[index];
                    document.getElementById('filter-start-date').value = clickedDate;
                    document.getElementById('filter-end-date').value = clickedDate;
                    applyFilters();
                }
            }
        }
    });
}

function filterByCategoryDirect(categoryName) {
    const categorySelect = document.getElementById('filter-category');
    categorySelect.value = categoryName;
    applyFilters();
}

function applyFilters() {
    const search = document.getElementById('filter-search').value.toLowerCase().trim();
    const status = document.getElementById('filter-status').value;
    const selectedCategory = document.getElementById('filter-category').value;
    const startDateVal = document.getElementById('filter-start-date').value;
    const endDateVal = document.getElementById('filter-end-date').value;

    const startDate = startDateVal ? new Date(startDateVal + "T00:00:00") : null;
    const endDate = endDateVal ? new Date(endDateVal + "T23:59:59") : null;

    currentFilteredData = allReports.filter(function(r) {
        const matchesSearch = 
            (r.sewadarName || '').toLowerCase().includes(search) ||
            (r.canteenNumber || '').toString().toLowerCase().includes(search) ||
            (r.dicName || '').toLowerCase().includes(search);

        const excCount = r.exceptionsCount || 0;
        let matchesStatus = true;
        if (status === 'ISSUES') matchesStatus = excCount > 0;

        let matchesCategory = true;
        if (selectedCategory !== 'ALL') {
            matchesCategory = r.categorizedIssues && r.categorizedIssues.some(function(c) {
                return normalizeCategory(c.category) === selectedCategory && c.issueCount > 0;
            });
        }

        let matchesDate = true;
        if (r.createdAt && r.createdAt.seconds) {
            const reportDate = new Date(r.createdAt.seconds * 1000);
            if (startDate && reportDate < startDate) matchesDate = false;
            if (endDate && reportDate > endDate) matchesDate = false;
        } else if (r.date) {
            const reportDate = new Date(r.date + "T00:00:00");
            if (startDate && reportDate < startDate) matchesDate = false;
            if (endDate && reportDate > endDate) matchesDate = false;
        }

        return matchesSearch && matchesStatus && matchesCategory && matchesDate;
    });

    updateStatsAndVisuals(currentFilteredData);
    currentPage = 1;
    renderPaginatedView();
}

function clearAllFilters() {
    document.getElementById('filter-search').value = '';
    document.getElementById('filter-status').value = 'ALL';
    document.getElementById('filter-category').value = 'ALL';
    document.getElementById('filter-start-date').value = '';
    document.getElementById('filter-end-date').value = '';
    applyFilters();
}

function renderPaginatedView() {
    const totalRecords = currentFilteredData.length;
    const totalPages = Math.ceil(totalRecords / pageSize) || 1;

    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    const startIndex = (currentPage - 1) * pageSize;
    const endIndex = Math.min(startIndex + pageSize, totalRecords);
    const paginatedSlice = currentFilteredData.slice(startIndex, endIndex);

    renderTable(paginatedSlice);

    document.getElementById('pagination-info').innerText = 
        totalRecords > 0 
            ? 'Showing ' + (startIndex + 1) + ' - ' + endIndex + ' of ' + totalRecords + ' entries' 
            : 'Showing 0 - 0 of 0 entries';

    document.getElementById('page-num').innerText = 'Page ' + currentPage + ' of ' + totalPages;
    document.getElementById('btn-prev').disabled = currentPage === 1;
    document.getElementById('btn-next').disabled = currentPage === totalPages || totalRecords === 0;
}

function renderTable(data) {
    const tableBody = document.getElementById('table-body');
    if (data.length === 0) {
        tableBody.innerHTML = '<tr><td colspan="6" style="text-align:center; color: var(--text-muted);">No matching reports found.</td></tr>';
        return;
    }

    let html = '';
    data.forEach(function(r) {
        const dateFormatted = r.createdAt ? new Date(r.createdAt.seconds * 1000).toLocaleString('en-GB') : (r.date || 'N/A');
        const excCount = r.exceptionsCount || 0;
        const badge = excCount > 0 
            ? '<span class="badge badge-danger">' + excCount + ' Issues</span>'
            : '<span style="color: var(--text-muted); font-size: 0.8rem; font-weight: 600;">0 Issues</span>';

        let categoryTags = '<span style="color: var(--text-muted); font-size: 0.8rem;">None</span>';
        if (r.categorizedIssues && r.categorizedIssues.length > 0) {
            const failedCats = r.categorizedIssues.filter(function(c) { return c.issueCount > 0; });
            if (failedCats.length > 0) {
                categoryTags = failedCats.map(function(c) {
                    const normCat = normalizeCategory(c.category);
                    return '<span style="display:inline-block; margin:2px; padding:2px 6px; background:#fef3c7; color:#92400e; border-radius:4px; font-size:0.75rem; font-weight:600; cursor:pointer;" onclick="filterByCategoryDirect(\'' + normCat + '\')">' + normCat + ' (' + c.issueCount + ')</span>';
                }).join(' ');
            }
        }

        html += '<tr>' +
            '<td>' + dateFormatted + '</td>' +
            '<td><strong>' + (r.canteenNumber || 'N/A') + '</strong></td>' +
            '<td>' + (r.sewadarName || 'N/A') + '</td>' +
            '<td>' + badge + '</td>' +
            '<td>' + categoryTags + '</td>' +
            '<td><button class="btn-view" onclick="viewReport(\'' + r.id + '\')">View Analysis</button></td>' +
        '</tr>';
    });

    tableBody.innerHTML = html;
}

function viewReport(id) {
    const report = allReports.find(function(r) { return r.id === id; });
    if (!report) return;

    const modalContent = document.getElementById('modal-content');
    
    let html = '<div style="background: white; padding: 12px; border: 1px solid var(--border); border-radius: 6px; margin-bottom: 16px;">' +
        '<div style="display:grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 0.85rem;">' +
            '<div><strong>Canteen:</strong> ' + (report.canteenNumber || 'N/A') + '</div>' +
            '<div><strong>Sewadar:</strong> ' + (report.sewadarName || 'N/A') + '</div>' +
            '<div><strong>DIC:</strong> ' + (report.dicName || 'N/A') + '</div>' +
            '<div><strong>Date:</strong> ' + (report.createdAt ? new Date(report.createdAt.seconds * 1000).toLocaleString('en-GB') : (report.date || 'N/A')) + '</div>' +
        '</div>' +
    '</div>' +
    '<h3 style="font-size: 0.95rem; font-weight:700; color: var(--primary); margin-bottom: 12px;">Categorized Analysis & Remarks</h3>';

    if (report.categorizedIssues && report.categorizedIssues.length > 0) {
        report.categorizedIssues.forEach(function(sec) {
            const normCategory = normalizeCategory(sec.category);
            const isClean = sec.issueCount === 0;
            const cardBg = isClean ? '#ffffff' : '#fff1f2';
            const cardBorder = isClean ? '#fecdd3' : '#fecdd3';
            const statusBadge = isClean 
                ? '<span style="background:#f1f5f9; color:#64748b; padding:2px 8px; border-radius:10px; font-weight:600; font-size:0.75rem;">0 ISSUES</span>'
                : '<span style="background:#fee2e2; color:#991b1b; padding:2px 8px; border-radius:10px; font-weight:700; font-size:0.75rem;">' + sec.issueCount + ' ISSUES</span>';

            html += '<div style="background: ' + cardBg + '; border: 1px solid ' + cardBorder + '; border-radius: 8px; padding: 14px; margin-bottom: 12px;">' +
                '<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 8px;">' +
                    '<strong style="font-size: 0.9rem; color: #0f172a;">' + normCategory + '</strong>' +
                    statusBadge +
                '</div>';

            if (sec.items && sec.items.length > 0) {
                html += '<ul style="margin: 0 0 8px 18px; font-size: 0.85rem; color: #334155;">';
                sec.items.forEach(function(item) {
                    html += '<li style="margin-bottom: 2px;">' + item + '</li>';
                });
                html += '</ul>';
            } else {
                html += '<div style="font-size: 0.8rem; color: #64748b; margin-bottom: 8px;">No exceptions recorded in this category.</div>';
            }

            if (sec.remarks) {
                html += '<div style="background: rgba(255,255,255,0.75); border-left: 3px solid #0284c7; padding: 6px 10px; font-size: 0.8rem; color: #0f172a; border-radius: 0 4px 4px 0;">' +
                    '<strong>Remarks:</strong> ' + sec.remarks +
                '</div>';
            }

            html += '</div>';
        });
    }

    if (report.generalFeedback && report.generalFeedback.trim() !== '') {
        html += '<div style="background: #e0f2fe; border: 1px solid #bae6fd; border-radius: 8px; padding: 14px; margin-bottom: 16px;">' +
            '<strong style="font-size: 0.9rem; color: #0369a1; display: block; margin-bottom: 6px;">💬 Feedback / Suggestion / Observation</strong>' +
            '<div style="font-size: 0.85rem; color: #0f172a; white-space: pre-wrap;">' + report.generalFeedback + '</div>' +
        '</div>';
    }

    if (report.fullReportText && report.fullReportText.trim() !== '') {
        html += '<div style="margin-top: 16px;">' +
            '<strong style="font-size: 0.9rem; color: var(--primary); display: block; margin-bottom: 8px;">📄 Full Text Report</strong>' +
            '<pre style="background: #ffffff; border: 1px solid var(--border); border-radius: 8px; padding: 12px; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 0.8rem; white-space: pre-wrap; color: var(--text-main); overflow-x: auto;">' + report.fullReportText + '</pre>' +
        '</div>';
    }

    modalContent.innerHTML = html;
    document.getElementById('detail-modal').style.display = 'flex';
}

function closeModal() {
    document.getElementById('detail-modal').style.display = 'none';
}

/* Consolidated Report Modal */
function openConsolidatedModal() {
    document.getElementById('consolidated-modal').style.display = 'flex';
    fetchAndGenerateConsolidatedReport();
}

function closeConsolidatedModal() {
    document.getElementById('consolidated-modal').style.display = 'none';
}

async function fetchAndGenerateConsolidatedReport() {
    const outputEl = document.getElementById('report-output');
    const targetDateVal = document.getElementById('report-target-date').value;
    const whatsappBtn = document.getElementById('whatsapp-share-btn');

    if (!targetDateVal) {
        outputEl.innerText = "Please select a valid date to generate the report.";
        whatsappBtn.style.display = 'none';
        return;
    }

    outputEl.innerText = "Fetching data for " + targetDateVal + "...";
    whatsappBtn.style.display = 'none';

    try {
        const snapshot = await db.collection("reports").get();

        if (snapshot.empty) {
            outputEl.innerText = "No records found in Firestore database.";
            return;
        }

        const hierarchy = {};
        let totalFilteredDocs = 0;

        snapshot.forEach(function(doc) {
            const data = doc.data();

            // STRICT FILTERING: Strict match on mode === 'visit'.
            // Excludes non-visit entries (e.g. 'not visit', 'no visit', 'call', etc.)
            const rawMode = data.mode ? String(data.mode).trim().toLowerCase() : '';
            if (rawMode !== 'visit') {
                return;
            }

            let recDateStr = null;
            if (data.createdAt && data.createdAt.seconds) {
                const dateObj = new Date(data.createdAt.seconds * 1000);
                recDateStr = dateObj.toISOString().split('T')[0];
            } else if (data.date) {
                recDateStr = data.date;
            }

            if (recDateStr !== targetDateVal) {
                return;
            }

            totalFilteredDocs++;

            const slot = data.slot || "Unassigned Slot";
            const canteen = data.canteenNumber || "Unknown Canteen";
            const exceptions = data.exceptions || [];

            if (!hierarchy[slot]) {
                hierarchy[slot] = {};
            }

            exceptions.forEach(function(ex) {
                const rawCategory = ex.category || "General";
                const normCategory = normalizeCategory(rawCategory);
                const issueKey = ex.item || "Unspecified Issue";
                const remarkText = ex.remark || "No remark provided";

                if (!hierarchy[slot][normCategory]) {
                    hierarchy[slot][normCategory] = {};
                }

                if (!hierarchy[slot][normCategory][canteen]) {
                    hierarchy[slot][normCategory][canteen] = [];
                }

                hierarchy[slot][normCategory][canteen].push({ issue: issueKey, remark: remarkText });
            });
        });

        const formattedDisplayDate = getFormattedDateWithDay(targetDateVal);

        let textReport = "📊 *CONSOLIDATED QC VISIT REPORT*\n";
        textReport += "📅 *DATE:* " + formattedDisplayDate + "\n";
        textReport += "📝 *TOTAL AUDITS ON THIS DAY:* " + totalFilteredDocs + "\n";
        textReport += "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n";

        const sortedSlots = Object.keys(hierarchy).sort(function(a, b) {
            let indexA = SLOT_HIERARCHY.indexOf(a);
            let indexB = SLOT_HIERARCHY.indexOf(b);
            if (indexA === -1) indexA = 99;
            if (indexB === -1) indexB = 99;
            return indexA - indexB;
        });

        if (sortedSlots.length === 0 || totalFilteredDocs === 0) {
            textReport += "✅ No visits or exceptions reported for date: " + formattedDisplayDate + ".";
        } else {
            sortedSlots.forEach(function(slotName) {
                textReport += "⏰ *SLOT: " + slotName.toUpperCase() + "*\n";
                textReport += "====================================\n";

                const categoriesObj = hierarchy[slotName];
                const categories = Object.keys(categoriesObj);

                if (categories.length === 0) {
                    textReport += "  ✅ No issues recorded in this slot.\n\n";
                    return;
                }

                categories.forEach(function(catName) {
                    const canteensObj = categoriesObj[catName];
                    
                    let totalCategoryIssues = 0;
                    Object.values(canteensObj).forEach(function(itemsList) {
                        totalCategoryIssues += itemsList.length;
                    });

                    textReport += "\n📁 *CATEGORY: " + catName.toUpperCase() + " (" + totalCategoryIssues + ")*\n";
                    textReport += "------------------------------------\n";

                    Object.keys(canteensObj).sort().forEach(function(canteenNum) {
                        textReport += "      🏬 *Canteen " + canteenNum + ":*\n";
                        canteensObj[canteenNum].forEach(function(itemObj) {
                            textReport += "          • " + itemObj.issue + " — 💬 " + itemObj.remark + "\n";
                        });
                    });
                });

                textReport += "\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n";
            });
        }

        outputEl.innerText = textReport;

        whatsappBtn.href = "https://api.whatsapp.com/send?text=" + encodeURIComponent(textReport);
        whatsappBtn.style.display = 'inline-flex';

    } catch (err) {
        console.error("Error generating consolidated report:", err);
        outputEl.innerText = "Error fetching data: " + err.message;
        whatsappBtn.style.display = 'none';
    }
}

function copyConsolidatedReport() {
    const text = document.getElementById('report-output').innerText;
    if (!text || text.startsWith("Select") || text.startsWith("Fetching")) {
        alert("Please generate the report before copying.");
        return;
    }
    navigator.clipboard.writeText(text).then(function() {
        alert("Consolidated report copied to clipboard!");
    }).catch(function(err) {
        alert("Failed to copy text: " + err);
    });
}

function nextPage() { currentPage++; renderPaginatedView(); }
function prevPage() { currentPage--; renderPaginatedView(); }
function changePageSize() {
    pageSize = parseInt(document.getElementById('page-size').value, 10);
    currentPage = 1;
    renderPaginatedView();
}

function exportToCSV() {
    if (currentFilteredData.length === 0) {
        alert("No data available to export.");
        return;
    }

    const headers = ["Report ID", "Date & Time", "Canteen Number", "Sewadar Name", "DIC Name", "Exceptions Count", "Flagged Categories", "Category Remarks", "General Feedback"];
    const rows = currentFilteredData.map(function(r) {
        const dateFormatted = r.createdAt 
            ? '"' + new Date(r.createdAt.seconds * 1000).toLocaleString('en-GB') + '"' 
            : '"' + (r.date || 'N/A') + '"';

        let flaggedCats = "";
        let remarksSummary = "";

        if (r.categorizedIssues) {
            const failed = r.categorizedIssues.filter(function(c) { return c.issueCount > 0; });
            flaggedCats = failed.map(function(c) { return normalizeCategory(c.category) + ' (' + c.issueCount + ')'; }).join("; ");
            remarksSummary = r.categorizedIssues
                .filter(function(c) { return c.remarks; })
                .map(function(c) { return normalizeCategory(c.category) + ': ' + c.remarks; })
                .join("; ");
        }

        return [
            '"' + r.id + '"',
            dateFormatted,
            '"' + (r.canteenNumber || '').toString().replace(/"/g, '""') + '"',
            '"' + (r.sewadarName || '').replace(/"/g, '""') + '"',
            '"' + (r.dicName || '').replace(/"/g, '""') + '"',
            r.exceptionsCount || 0,
            '"' + flaggedCats.replace(/"/g, '""') + '"',
            '"' + remarksSummary.replace(/"/g, '""') + '"',
            '"' + (r.generalFeedback || '').replace(/"/g, '""') + '"'
        ].join(",");
    });

    const csvContent = [headers.join(","), ...rows].join("\n");
    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    
    const dateStamp = new Date().toISOString().slice(0, 10);
    link.setAttribute("href", url);
    link.setAttribute("download", "QC_Inspection_Reports_" + dateStamp + ".csv");
    
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}
